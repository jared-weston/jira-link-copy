{
  "manifest_version": 3,
  "name": "Jira Link Copy",
  "version": "1.0.0",
  "description": "Adds a clipboard button to Jira issues that copies a hyperlink like \"ABC-123 Do The Thing\".",
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-link-copy@jared-weston.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.jira.com/*",
        "*://*.atlassian.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
